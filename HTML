let carritoSelection = [];
let marcaActiva = "todas";
let tipoActivo = "todos";
function renderizarCatalogo(lista) {
const contenedor = document.getElementById("lista-productos");
contenedor.innerHTML = "";
if(lista.length === 0) {
contenedor.innerHTML = <p style="grid-column: 1/-1; text-align:center; padding:40px; color:#7f8c8d;">No hay productos que coincidan con los filtros establecidos.</p>;
return;
}
lista.forEach(prod => {
const card = document.createElement("div");
card.className = "producto";
card.innerHTML = <div> <div class="producto-imagen-wrapper"> <span class="badge-marca">${prod.marca}</span> <img src="${prod.img}" alt="${prod.nombre}"> </div> <h3>${prod.nombre}</h3> <p>${prod.desc}</p> </div> <button onclick="agregarAlCarrito('${prod.nombre}')">Seleccionar para Cotizar</button>;
contenedor.appendChild(card);
});
}
function agregarAlCarrito(nombre) {
const existe = carritoSelection.find(item => item.nombre === nombre);
if(existe) { existe.cantidad++; }
else { carritoSelection.push({ nombre: nombre, cantidad: 1 }); }
actualizarInterfazCarrito();
}
function eliminarDelCarrito(nombre) {
carritoSelection = carritoSelection.filter(item => item.nombre !== nombre);
actualizarInterfazCarrito();
}
function actualizarInterfazCarrito() {
const contenedorLista = document.getElementById("lista");
const btnPagar = document.getElementById("pagar");
const contador = document.getElementById("contador");
let totalItems = carritoSelection.reduce((acc, item) => acc + item.cantidad, 0);
contador.innerText = totalItems;
if(carritoSelection.length === 0) {
contenedorLista.innerHTML = <p style="color:#aaa; text-align:center; padding: 20px 0;">No has seleccionado productos.</p>;
btnPagar.style.display = "none";
return;
}
btnPagar.style.display = "block";
contenedorLista.innerHTML = "";
carritoSelection.forEach(item => {
const row = document.createElement("div");
row.className = "item-carrito";
row.innerHTML = <span><strong>${item.cantidad}x</strong> ${item.nombre}</span> <button class="btn-eliminar" onclick="eliminarDelCarrito('${item.nombre}')">&times;</button>;
contenedorLista.appendChild(row);
});
}
function filtrarProductos() {
const texto = document.getElementById("busqueda").value.toLowerCase();
let filtrados = productosData.filter(p => p.nombre.toLowerCase().includes(texto));
if(marcaActiva !== "todas") {
filtrados = filtrados.filter(p => p.marca === marcaActiva);
}
if(tipoActivo !== "todos") {
filtrados = filtrados.filter(p => p.tipo === tipoActivo);
}
renderizarCatalogo(filtrados);
}
// LÓGICA DE FILTRADO POR MARCAS ASOCIADA A LOS NUEVOS BOTONES
function filtrarMarca(marca, elemento) {
marcaActiva = marca;
document.querySelectorAll(".btn-marca").forEach(b => b.classList.remove("activo"));
elemento.classList.add("activo");
filtrarProductos();
}
function filtrarTipo(tipo, elemento) {
tipoActivo = tipo;
document.querySelectorAll(".btn-tipo").forEach(b => b.classList.remove("activo"));
elemento.classList.add("activo");
filtrarProductos();
}
function abrirModal() {
document.getElementById("modal-pago").style.display = "flex";
let numeroTelefono = "5512760092";
let mensaje = "Hola Don Justo Veterinaria, solicito cotización para el siguiente pedido:\n\n";
carritoSelection.forEach(item => { mensaje += • ${item.cantidad} pz. - ${item.nombre}\n; });
let urlWa = https://whatsapp.com{numeroTelefono}&text=${encodeURIComponent(mensaje)};
document.getElementById("enviar-wa").href = urlWa;
}
function cerrarModal() { document.getElementById("modal-pago").style.display = "none"; }
renderizarCatalogo(productosData);
